// Install to: <Quaestio repo root>/opencode.jsonc  (commit it)
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],

  "mcp": {
    // Drives a real browser so agents can click through flows and take screenshots.
    "playwright": { "type": "local", "command": ["npx", "-y", "@playwright/mcp@latest"], "enabled": false }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "npm run*": "allow",
      "npm test*": "allow",
      "npx tsc*": "allow",
      "npx vitest*": "allow",
      "npm install*": "ask",
      "npm publish*": "deny"
    }
  },

  "watcher": { "ignore": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.vite/**"] }
}
