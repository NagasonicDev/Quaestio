diff --git a/frontend/src/components/StimulusEditor.tsx b/frontend/src/components/StimulusEditor.tsx
new file mode 100644
index 0000000..fbd47e9
--- /dev/null
+++ b/frontend/src/components/StimulusEditor.tsx
@@ -0,0 +1,80 @@
+import { useState, type FormEvent } from "react";
+import { BlockEditor, blocksToPayload, type EditableBlock } from "./BlockEditor";
+import type { StimulusWithContent } from "../api/types";
+import { Button } from "./ui/button";
+import { Input } from "./ui/input";
+import { Panel, PanelHead } from "./system";
+
+function toEditable(blocks: StimulusWithContent["blocks"] | null | undefined): EditableBlock[] {
+  if (!blocks || blocks.length === 0) return [];
+  return blocks
+    .slice()
+    .sort((a, b) => a.position - b.position)
+    .map((b) => ({ tempId: b.block_id, block_type: b.block_type, content: b.content }));
+}
+
+export interface StimulusEditorProps {
+  existing?: StimulusWithContent | null;
+  onSave: (data: { title: string | null; body: ReturnType<typeof blocksToPayload> }) => Promise<void> | void;
+  onCancel: () => void;
+  saving?: boolean;
+}
+
+export function StimulusEditor({ existing, onSave, onCancel, saving = false }: StimulusEditorProps) {
+  const [title, setTitle] = useState<string>(existing?.title ?? "");
+  const [blocks, setBlocks] = useState<EditableBlock[]>(() =>
+    toEditable(existing?.blocks)
+  );
+
+  const [submitting, setSubmitting] = useState(false);
+
+  async function handleSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (submitting || saving) return;
+    setSubmitting(true);
+    try {
+      await onSave({
+        title: title.trim() || null,
+        body: blocksToPayload(blocks),
+      });
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  const isSaving = submitting || saving;
+
+  return (
+    <form onSubmit={handleSubmit} className="space-y-4">
+      <Panel>
+        <PanelHead title={existing ? "Edit stimulus" : "New stimulus"} />
+        <div className="space-y-4 p-4">
+          <div className="space-y-1.5">
+            <label className="label">Title (optional)</label>
+            <Input
+              value={title}
+              onChange={(e) => setTitle(e.target.value)}
+              placeholder="e.g. Stimulus 1: Circuit diagram"
+            />
+          </div>
+        </div>
+      </Panel>
+
+      <BlockEditor
+        label="Stimulus content"
+        blocks={blocks}
+        onChange={setBlocks}
+        note="Add text, figures, equations, tables, etc. for this stimulus."
+      />
+
+      <div className="flex justify-end gap-2">
+        <Button type="button" variant="outline" onClick={onCancel} disabled={isSaving}>
+          Cancel
+        </Button>
+        <Button type="submit" disabled={isSaving}>
+          {isSaving ? "Saving…" : existing ? "Save changes" : "Create stimulus"}
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/frontend/src/components/StimulusManager.tsx b/frontend/src/components/StimulusManager.tsx
new file mode 100644
index 0000000..5ba934c
--- /dev/null
+++ b/frontend/src/components/StimulusManager.tsx
@@ -0,0 +1,193 @@
+import { useEffect, useState } from "react";
+import { Plus, Pencil, Trash2 } from "lucide-react";
+import { api } from "../api/client";
+import type { Stimulus, StimulusWithContent } from "../api/types";
+import { Panel, PanelHead } from "./system";
+import { Button } from "./ui/button";
+import { Modal, useConfirm } from "./ui/modal";
+import { notify } from "../lib/notifications";
+import { StimulusEditor } from "./StimulusEditor";
+
+interface StimulusManagerProps {
+  courseId: string;
+  onSelect?: (stimulus: Stimulus) => void;
+}
+
+export function StimulusManager({ courseId, onSelect }: StimulusManagerProps) {
+  const confirm = useConfirm();
+  const [stimuli, setStimuli] = useState<Stimulus[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [editing, setEditing] = useState<StimulusWithContent | null>(null);
+  const [saving, setSaving] = useState(false);
+
+  async function load() {
+    setLoading(true);
+    try {
+      const list = await api.listStimuliForCourse(courseId);
+      setStimuli(list);
+    } catch (err) {
+      notify("Could not load stimuli", "error", err instanceof Error ? err.message : "Failed to load stimuli.");
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    load();
+  }, [courseId]);
+
+  function openCreate() {
+    setEditing(null);
+    setShowModal(true);
+  }
+
+  async function openEdit(stimulus: Stimulus) {
+    try {
+      setSaving(true);
+      const full = await api.getStimulus(stimulus.stimulus_id);
+      setEditing(full);
+      setShowModal(true);
+    } catch (err) {
+      notify("Could not load stimulus", "error", err instanceof Error ? err.message : "Failed to load stimulus.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  async function handleSave(data: { title: string | null; body: any[] }) {
+    setSaving(true);
+    try {
+      if (editing) {
+        await api.updateStimulus(editing.stimulus_id, {
+          title: data.title,
+          body: data.body,
+        });
+        notify("Stimulus updated", "success");
+      } else {
+        await api.createStimulus({
+          course_id: courseId,
+          title: data.title,
+          body: data.body,
+        });
+        notify("Stimulus created", "success");
+      }
+      setShowModal(false);
+      setEditing(null);
+      await load();
+    } catch (err) {
+      notify("Could not save stimulus", "error", err instanceof Error ? err.message : "Failed to save stimulus.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  async function handleDelete(stimulus: Stimulus) {
+    const ok = await confirm({
+      title: "Delete this stimulus?",
+      description: "This stimulus will be removed and unlinked from any questions. This can't be undone.",
+      confirmLabel: "Delete stimulus",
+      destructive: true,
+    });
+    if (!ok) return;
+    try {
+      await api.deleteStimulus(stimulus.stimulus_id);
+      notify("Stimulus deleted", "success");
+      await load();
+    } catch (err) {
+      notify("Could not delete stimulus", "error", err instanceof Error ? err.message : "Failed to delete stimulus.");
+    }
+  }
+
+  return (
+    <Panel>
+      <PanelHead
+        title="Stimuli"
+        action={
+          <Button type="button" size="sm" onClick={openCreate}>
+            <Plus /> New stimulus
+          </Button>
+        }
+      />
+      <div className="p-4">
+        {loading && <p className="text-sm text-muted-foreground">Loading stimuli…</p>}
+        {!loading && stimuli.length === 0 && (
+          <p className="text-sm text-muted-foreground">No stimuli yet. Create one to attach to questions.</p>
+        )}
+        {!loading && stimuli.length > 0 && (
+          <div className="space-y-2">
+            {stimuli.map((stimulus) => (
+              <div
+                key={stimulus.stimulus_id}
+                className="flex items-center justify-between rounded-md border border-border px-3 py-2"
+              >
+                <div className="min-w-0">
+                  <p className="text-sm font-medium truncate">
+                    {stimulus.title || `Stimulus ${stimulus.stimulus_id.slice(0, 8)}`}
+                  </p>
+                  <p className="text-xs text-muted-foreground">
+                    {new Date(stimulus.created_at).toLocaleString()}
+                  </p>
+                </div>
+                <div className="flex gap-1">
+                  {onSelect && (
+                    <Button
+                      type="button"
+                      size="sm"
+                      variant="ghost"
+                      onClick={() => onSelect(stimulus)}
+                    >
+                      Select
+                    </Button>
+                  )}
+                  <Button
+                    type="button"
+                    size="icon"
+                    variant="ghost"
+                    title="Edit stimulus"
+                    onClick={() => openEdit(stimulus)}
+                  >
+                    <Pencil />
+                  </Button>
+                  <Button
+                    type="button"
+                    size="icon"
+                    variant="ghost"
+                    className="text-destructive hover:bg-destructive/10 hover:text-destructive"
+                    title="Delete stimulus"
+                    onClick={() => handleDelete(stimulus)}
+                  >
+                    <Trash2 />
+                  </Button>
